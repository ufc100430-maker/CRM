{
  "name": "phonestore-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram Mini App + Bot CRM for smartphone retail chain",
  "scripts": {
    "dev:web": "pnpm --filter @phonestore/web dev",
    "dev:bot": "pnpm --filter @phonestore/bot dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @phonestore/db generate",
    "db:migrate": "pnpm --filter @phonestore/db migrate",
    "db:push": "pnpm --filter @phonestore/db push",
    "db:studio": "pnpm --filter @phonestore/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  }
}
