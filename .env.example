# =====================================
# PhoneStore CRM — Environment variables
# =====================================
# Скопіюй цей файл у .env.local і заповни значення.
# НЕ КОМІТЬ .env у git!

# --- Database (Supabase) ---
# Direct connection URL (для міграцій)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
# Pooled connection URL (для runtime у Vercel)
DATABASE_POOL_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="phonestore_crm_bot"

# --- Mini App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- JWT для сесій ---
JWT_SECRET=""  # згенеруй: openssl rand -base64 64

# --- Owner (перший власник системи) ---
INITIAL_OWNER_TELEGRAM_USERNAME=""  # без @, наприклад: "ufc100430"

# --- Sentry (опційно на старті) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# --- App settings ---
NODE_ENV="development"
TZ="Europe/Kiev"
